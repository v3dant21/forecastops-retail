# ForecastOps Environment Configuration

# Database
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=forecastops
DATABASE_USER=forecastops
DATABASE_PASSWORD=forecastops

# Data
DATA_SUBSET_PRODUCTS=100
DATA_SUBSET_STORES=5
DATA_SUBSET_DAYS=1000

# Model
MODEL_RANDOM_SEED=42
MODEL_BATCH_SIZE=128
MODEL_EPOCHS=50

# Features (comma-separated values)
FEATURE_LAGS=1,2,3,7,14,21,28
FEATURE_ROLLING_WINDOWS=7,14,28
FEATURE_ROLLING_FUNCTIONS=mean,std

# MLflow
MLFLOW_TRACKING_URI=sqlite:///mlruns/mlflow.db

# Training
TRAINING_VALIDATION_SPLIT=0.2
TRAINING_TEST_SPLIT=0.1
TRAINING_TIME_AWARE_SPLIT=true

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
